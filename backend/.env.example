# 环境变量模板（提交到 git，供团队成员参考）
# 复制为 .env 并填入真实值：cp .env.example .env
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=sk-your-key-here

# 数据库（Diesel/SQLite；缺省值见 main.rs）
DATABASE_URL=sqlite://backend.db

# 仿真内核可执行文件。V4 生产启动必填；缺失或 capability 不满足时启动失败，不回退 stub。
# 本地开发示例（绝对路径最稳，见 docs/v4-deployment.md）：
#   TENSOREVAL_BIN=/Users/dongshufeng/IdeaProjects/eig-rs/target/release/tensoreval
# 注意：cargo run 在 backend/ 下执行，相对路径按 backend/ 解析，不能用仓库根的 ../eig-rs。
# TENSOREVAL_BIN=tensoreval

# Sparrowzz 资源根目录：启动时校验 dss 下的 docs/catalog/examples 合同并发布只读快照。
# 它直接指向 eig-rs/sparrowzz；从仓库根看本地开发路径通常为 ../eig-rs/sparrowzz。
# cargo run 在 backend/ 下执行时，相对路径应写为 ../../eig-rs/sparrowzz；绝对路径最稳。
# V4 非测试启动必填。
SPARROWZZ_DIR=/absolute/path/to/eig-rs/sparrowzz

# Agent 资源 bundle；未知版本或 hash/引擎合同不匹配时启动失败。
# V4 对话 Agent 仅准备研究配置并管理受控资源；脚本生成由确认后的专用 author 负责。
AGENT_BUNDLE_VERSION=v4.0.0

# 固定用户登录会话。公网 HTTPS 部署必须启用 Secure Cookie。
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false

# Agent admission；tensoreval 子进程在应用内固定为最多 4 个。
# AGENT_MAX_CONCURRENT_RUNS=8
# AGENT_MAX_USER_RUNS=2
# AGENT_QUEUE_CAPACITY=32

# 单次引擎调用超时（毫秒），缺省 120000（2 分钟）
# TENSOREVAL_TIMEOUT_MS=120000
# ENGINE_PROCESS_OUTPUT_MAX_BYTES=1048576
# SCRIPT_REPAIR_STDERR_MAX_BYTES=65536
# SCRIPT_REPAIR_MAX_ATTEMPTS=3
# AGENT_MODEL_RETRY_MAX=2

# 数据根目录（artifact、只读引擎快照、原生 Parquet 结果），缺省 "data"（即 backend/data/）
# DATA_DIR=data

# 每个用户的历史 artifact 配额和告警阈值。
# USER_ARTIFACT_LIMIT=20000
# USER_STORAGE_LIMIT_BYTES=21474836480
# STORAGE_WARNING_RATIO=0.8

# 上传和不可信归档限制。
# UPLOAD_SINGLE_FILE_LIMIT_BYTES=52428800
# UPLOAD_BATCH_LIMIT_BYTES=524288000
# UPLOAD_STAGING_TTL_HOURS=24
# ARCHIVE_MAX_ENTRIES=1000
# ARCHIVE_MAX_EXPANDED_BYTES=2147483648
# ARCHIVE_MAX_COMPRESSION_RATIO=100

# 单次结果发布限制。
# RESULT_MAX_FILES=100
# RESULT_MAX_FILE_BYTES=536870912
# RESULT_MAX_TOTAL_BYTES=2147483648
