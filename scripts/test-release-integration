#!/bin/sh
set -eu

# real DeepSeek and tensoreval complete the V4 semantic release journey
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${ZJUDSS_SKIP_DOTENV:-0}" != "1" ] && [ -f "$repo_root/backend/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$repo_root/backend/.env"
  set +a
fi

for required in DEEPSEEK_API_KEY TENSOREVAL_BIN SPARROWZZ_DIR; do
  eval "value=\${$required:-}"
  if [ -z "$value" ]; then
    echo "release_integration_missing:$required" >&2
    exit 2
  fi
done
if [ ! -x "$TENSOREVAL_BIN" ]; then
  echo "release_integration_binary_invalid" >&2
  exit 2
fi
if [ ! -d "$SPARROWZZ_DIR" ]; then
  echo "release_integration_sparrowzz_dir_invalid" >&2
  exit 2
fi

report_dir="$repo_root/target/release-integration"
run_root="$report_dir/run-$$"
raw_log="$run_root/raw.log"
public_log="$report_dir/release.log"
mkdir -p "$run_root/data" "$run_root/dataframes"

export RELEASE_ENGINE_REPORT="$report_dir/engine-report.json"
export RELEASE_LLM_REPORT="$report_dir/llm-report.json"
export RELEASE_DATAFRAME_DIR="$run_root/dataframes"
export DATA_DIR="$run_root/data"
export DATABASE_URL="sqlite://$run_root/release.db"
export LLM_PROVIDER=deepseek
ports=$(node -e '
  const net = require("node:net");
  const servers = [net.createServer(), net.createServer()];
  Promise.all(servers.map(server => new Promise((resolve, reject) => {
    server.once("error", reject);
    server.listen(0, "127.0.0.1", () => resolve(server.address().port));
  }))).then(values => Promise.all(servers.map(server => new Promise(resolve => server.close(resolve))))
    .then(() => process.stdout.write(values.join(" "))));
')
set -- $ports
export RELEASE_BACKEND_PORT="$1"
export RELEASE_FRONTEND_PORT="$2"

sanitize_log() {
  node -e '
    const fs = require("node:fs");
    let text = fs.readFileSync(process.argv[1], "utf8");
    for (const value of [process.env.DEEPSEEK_API_KEY, process.env.TENSOREVAL_BIN, process.env.SPARROWZZ_DIR, process.env.DATA_DIR, process.cwd()]) {
      if (value) text = text.split(value).join("<redacted>");
    }
    text = text.replace(/\/(?:Users|private|tmp)\/[^\s"`]+/g, "<path>");
    fs.writeFileSync(process.argv[2], text);
  ' "$raw_log" "$public_log"
}

finish() {
  code=$?
  trap - EXIT INT TERM
  if [ -f "$raw_log" ]; then
    sanitize_log
    tail -n 40 "$public_log"
    rm -f "$raw_log"
  fi
  exit "$code"
}
trap finish EXIT INT TERM

"$repo_root/scripts/test-release-engine" >"$raw_log" 2>&1

cat > "$run_root/export-dataframes.rss" <<'EOF'
[bus, line, linecode, load, transformer, voltage_source, motor, transformer_winding, transformer_impedance, current_source, generator, ibr, switch, shunt, capacitor, reactor, spectrum, control_profile, xy_curve, storage, para] = import_dss("dss/models/4bus_daily_qsts/4bus_dy.dss");
EOF
(
  cd "$SPARROWZZ_DIR"
  "$TENSOREVAL_BIN" --df --result-dir "$RELEASE_DATAFRAME_DIR" --output-format parquet "$run_root/export-dataframes.rss"
) >>"$raw_log" 2>&1

(
  cd "$repo_root/frontend"
  NODE_PATH=./node_modules ./node_modules/.bin/playwright test --config=playwright.release.config.ts
) >>"$raw_log" 2>&1

if [ ! -s "$RELEASE_ENGINE_REPORT" ]; then
  echo "release_integration_engine_report_missing" >>"$raw_log"
  exit 1
fi
if [ ! -s "$RELEASE_LLM_REPORT" ]; then
  echo "release_integration_llm_report_missing" >>"$raw_log"
  exit 1
fi
node -e '
  const fs = require("node:fs");
  const report = JSON.parse(fs.readFileSync(process.env.RELEASE_LLM_REPORT, "utf8"));
  if (!report.success || !report.attempts?.some((attempt) => attempt.outcome === "passed")) process.exit(1);
  if (report.agentBundleVersion !== "v4.0.0" || !/^[a-f0-9]{64}$/.test(report.agentBundleSha256 ?? "")) process.exit(1);
  if (!/^[a-f0-9]{64}$/.test(report.userSeedSha256 ?? "") || !(report.userCount > 0)) process.exit(1);
  if (!["ENGINE-RELEASE-001", "REAL-RELEASE-001", "AGENT-STUDY-PLANNING-001"].every((id) => report.testIds?.includes(id))) process.exit(1);
  if (!/^[a-f0-9]{64}$/.test(report.engineBinarySha256 ?? "") || !report.engineContract) process.exit(1);
  if (!/^ers_[a-f0-9]{32}$/.test(report.engineResourceSnapshot ?? "")) process.exit(1);
  const counts = report.engineExampleCounts;
  if (!counts || counts.bundles < 1 || counts.importable < 1) process.exit(1);
  if (counts.discovered !== counts.importable + counts.nonImportable) process.exit(1);
  if (!report.engineContractChecks?.staticModelImport || !report.engineContractChecks?.singleSolveModelImport) process.exit(1);
  if (report.engineContractChecks?.staticImportDataframes !== 21) process.exit(1);
  if (!(report.engineFacadeCatalog?.entries > 0) || report.engineFacadeCatalog.enabled !== report.engineFacadeCatalog.entries || report.engineFacadeCatalog.diagnostics !== 0) process.exit(1);
  if (report.finalState?.runCount !== 2 || report.finalState?.datasetCount !== 3 || report.finalState?.analysisRunCount !== 2 || report.finalState?.comparisonCount !== 1) process.exit(1);
  if (report.managedWorkflow?.status !== "succeeded" || !(report.managedWorkflow?.attemptCount > 0)) process.exit(1);
  const text = JSON.stringify(report);
  for (const value of [process.env.DEEPSEEK_API_KEY, process.env.TENSOREVAL_BIN, process.env.SPARROWZZ_DIR, process.env.DATA_DIR]) {
    if (value && text.includes(value)) process.exit(1);
  }
' >>"$raw_log" 2>&1
